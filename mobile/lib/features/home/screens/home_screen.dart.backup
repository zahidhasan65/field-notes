        boxShadow: [
          BoxShadow(
            color: const Color(0xFF17345C).withValues(alpha: 0.04),
            blurRadius: 14,
            offset: const Offset(0, -4),
          ),
        ],
      ),
      child: SafeArea(
        top: false,
        child: Padding(
          padding: const EdgeInsets.fromLTRB(12, 9, 12, 8),
          child: Row(
            children: const [
              Expanded(
                child: _NavigationItem(
                  icon: Icons.dashboard_rounded,
                  label: 'Home',
                  selected: true,
                ),
              ),
              Expanded(
                child: _NavigationItem(
                  icon: Icons.description_outlined,
                  label: 'Notes',
                ),
              ),
              Expanded(
                child: _NavigationItem(
                  icon: Icons.people_alt_outlined,
                  label: 'Customers',
                ),
              ),
              Expanded(
                child: _NavigationItem(
                  icon: Icons.settings_outlined,
